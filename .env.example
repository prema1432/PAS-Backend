# ==== PAS Backend environment configuration ====
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored - never commit real secrets.

# --- Supabase (Project Settings -> API in the Supabase dashboard) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional: service role key. Only set if you need to bypass RLS
# (admin/server-side operations). Keep this SECRET - never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=

# --- API docs protection ---
# Swagger/ReDoc/OpenAPI are DISABLED unless both values below are set, and once
# set they sit behind HTTP Basic auth. Leave empty in production if you don't
# want the schema exposed at all.
DOCS_USERNAME=admin
DOCS_PASSWORD=change-me-strong-password

# --- CORS ---
# Comma-separated list of allowed origins. "*" (default) allows any origin and
# cannot be combined with credentialed requests - set explicit origins in
# production, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# --- API versioning ---
# The URL segment that carries the versioned API: /api/v1/... Change this to
# publish a new surface (bump to v2), and keep the previous version mounted in
# app/modules/registry.py so existing clients keep working. The deployment
# routes (/, /info, /health, /docs) are never versioned.
API_VERSION=v1

# --- Rate limiting (per client IP, per minute) ---
# General API budget.
RATE_LIMIT_PER_MINUTE=120
# Sign-in / sign-up budget (kept tight to slow credential stuffing).
AUTH_RATE_LIMIT_PER_MINUTE=8

# --- Provider API key encryption ---
# Any long random string; it is hashed into a Fernet key. Required to store
# provider API keys (POST /api-keys returns 503 without it). Rotating this makes
# previously stored keys undecryptable, so treat it as permanent.
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Release version ---
# Optional: only set this to label a build (it defaults to app/__init__.py's
# __version__, which is the single source of truth for the release version).
# APP_VERSION=
